# ======================================================================
# GunGong (กันโกง) - Environment Configuration Template
# ======================================================================
#
# INSTRUCTIONS / คำแนะนำ:
#
# 1. Copy this file: cp .env.example .env
# 2. Fill in your own API credentials
# 3. NEVER commit your .env file to git!
#
# ======================================================================

# ===== Backend Configuration =====

# Google Gemini AI API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# LINE Messaging API Credentials
# Get yours at: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_LIFF_ID=your_liff_id_here

# Google Cloud Service Account JSON (for Firestore)
# Path to your service account JSON file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Firestore/Firebase Configuration
FIRESTORE_PROJECT_ID=your_firestore_project_id_here

# VirusTotal API Key (Optional - for URL malware scanning)
# Get yours at: https://www.virustotal.com/
# Leave empty if you don't have one (system will skip URL scanning)
VIRUSTOTAL_API_KEY=

# ===== Frontend Configuration =====

# Firebase Web App Configuration
# Get from: Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# LINE LIFF Configuration
# Get from: LINE Developers Console → Your Provider → LIFF
VITE_LIFF_ID=your_liff_id_here

# Backend API URL
# For development, use localhost. For production, use your deployed URL
VITE_API_BASE_URL=http://localhost:8000

# LINE Official Account URL
# Your LINE OA page URL (e.g., https://line.me/R/ti/p/@your-account-id)
VITE_LINE_OA_URL=https://line.me/R/ti/p/@your-line-oa

# ===== Production/Deployment Configuration =====

# Google Cloud Run Service URL (for production only)
# Leave empty for local development
CLOUD_RUN_SERVICE_URL=

# ======================================================================
# IMPORTANT SECURITY NOTES / ข้อควรระวัง:
# ======================================================================
#
# ✅ DO / ควรทำ:
# - Store this file securely and never commit to git
# - Use different credentials for development and production
# - Rotate credentials regularly
# - Use GitHub Secrets for CI/CD pipelines
# - Enable API restrictions in Google Cloud Console
#
# ❌ DON'T / ไม่ควรทำ:
# - Never share your actual API keys with anyone
# - Never commit .env file to git (already in .gitignore)
# - Never use production credentials in development
# - Never hardcode credentials in source code
#
# 🚨 IF CREDENTIALS ARE EXPOSED / หากข้อมูลรั่วไหล:
# 1. Revoke the exposed credentials immediately
# 2. Generate new credentials
# 3. Update this file and GitHub Secrets
# 4. Check git history for exposed secrets
#
# ======================================================================
