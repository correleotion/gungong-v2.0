# Browser Extension .gitignore

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build artifacts
*.crx
*.pem
*.zip
dist/
build/

# Node modules (if using build tools)
node_modules/
package-lock.json
yarn.lock

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development
.env.production

# Temporary files
*.tmp
*.temp
*~

# Testing
coverage/
.nyc_output/

# Cache
.cache/
*.cache

# Backup files
*.bak
*.backup
*.old
